{
	"name": "@cldmv/jsonv",
	"version": "1.2.0",
	"description": "Modern JSON parser extending JSON5 with ES2015-2025 features, year-based API",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/types/index.d.mts",
	"exports": {
		".": {
			"jsonv-dev": {
				"types": "./src/index.mts",
				"import": "./src/index.mts"
			},
			"types": "./dist/types/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./parser": {
			"jsonv-dev": {
				"types": "./src/parser.mts",
				"import": "./src/parser.mts"
			},
			"types": "./dist/types/parser.d.mts",
			"import": "./dist/parser.mjs"
		},
		"./*": {
			"jsonv-dev": {
				"types": "./src/years/*.mts",
				"import": "./src/years/*.mts"
			},
			"import": {
				"types": "./dist/types/years/*.d.mts",
				"default": "./dist/years/*.mjs"
			},
			"require": {
				"types": "./dist/types/years/*.d.mts",
				"default": "./dist/years/*.cjs"
			}
		}
	},
	"scripts": {
		"build": "npm run clean && tsup && npm run build:types && npm run generate:years",
		"clean": "node -e \"const{rmSync}=require('fs');rmSync('dist',{recursive:true,force:true});console.log('✓ Cleaned dist/')\"",
		"generate:years": "node scripts/generate-years.mjs",
		"build:plugin": "node scripts/build-plugin.mjs",
		"build:types": "tsc --project .configs/tsconfig.types.json",
		"build:ci": "npm run lint --if-present && npm run format:check --if-present && npm run build",
		"prepack": "npm run build",
		"test": "node tests/run-vitest.mjs && npm run test:cjs",
		"test:cjs": "npm run build && node --conditions=jsonv-dev --test tests/cjs/entry.test.cjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"test:types": "tsc --project .configs/tsconfig.build.json --noEmit",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet && npm run test:cjs",
		"ci:coverage": "npm run coverage",
		"lint": "eslint --config .configs/eslint.config.v9.mjs src tests",
		"lint:v8": "set ESLINT_USE_FLAT_CONFIG=true&& eslint --config .configs/eslint.config.mjs src tests",
		"format": "prettier --config .configs/.prettierrc --write \"src/**/*.{mts,cts,ts}\" \"tests/**/*.{mjs,ts}\"",
		"format:check": "prettier --config .configs/.prettierrc --check \"src/**/*.{mts,cts,ts}\" \"tests/**/*.{mjs,ts}\"",
		"fix:headers": "fix-headers --config .configs/fix-headers.json"
	},
	"keywords": [
		"json",
		"json5",
		"parser",
		"serializer",
		"config",
		"es2015",
		"es2020",
		"es2021",
		"bigint",
		"numeric-separators"
	],
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"license": "Apache-2.0",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CLDMV/jsonv.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/jsonv/issues"
	},
	"homepage": "https://github.com/CLDMV/jsonv#readme",
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"README.md",
		"LICENSE",
		"types/",
		"dist/",
		"!dist/**/*.map"
	],
	"devDependencies": {
		"@cldmv/configs": "^1.3.0",
		"@cldmv/eslint-plugin-jsonv": "^1.0.17",
		"@cldmv/fix-headers": "^2.2.4",
		"@cldmv/vitest-runner": "^1.5.6",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^8.0.3",
		"@html-eslint/eslint-plugin": "^0.67.0",
		"@html-eslint/parser": "^0.67.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"katex": ">=0.19.1 <1.0.0",
		"minimatch": "^11.0.3"
	}
}
