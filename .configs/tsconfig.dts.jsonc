{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationMap": true,
		"rootDir": "..",
		"outDir": "../types/src",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022",
		"skipLibCheck": true,
		"stripInternal": true
	},
	"include": ["../src/**/*.mjs", "../src/**/*.cjs"],
	"exclude": [
		"../tests",
		"../tools",
		"../types",
		"../.config",
		"../.configs",
		"../.data",
		"../dist",
		"../build",
		"../docs",
		"../node_modules",
		"../**/* copy.mjs",
		"../**/* copy*.mjs"
	]
}
